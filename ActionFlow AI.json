        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Meeting ID": "={{ $json.meetingId }}",
            "Meeting Title": "={{ $json.meetingTitle }}",
            "Owner": "={{ $json.owner }}",
            "Task": "={{ $json.task }}",
            "Due Date": "={{ $json.due_date }}",
            "Priority": "={{ $json.priority }}",
            "Status": "=Open",
            "Action Key": "={{ $json.meetingId + '|' + $json.task.toLowerCase().trim() }}"
          },
          "matchingColumns": [
            "Action Key"
          ]
        },
        "options": {}
      },
      "typeVersion": 4.5
    },
    {
      "id": "meeting-email",
      "name": "Email Action Items",
      "type": "n8n-nodes-base.gmail",
      "position": [
        4080,
        0
      ],
      "parameters": {
        "sendTo": "={{ $env.MEETING_EMAIL_TO || 'team@example.com' }}",
        "subject": "=Action items: {{ $('Normalize Meeting Output').first().json.meetingTitle }}",
        "message": "={{ $('Normalize Meeting Output').first().json.summary }}\n\nDECISIONS:\n{{ $('Normalize Meeting Output').first().json.key_decisions }}\n\nACTION ITEMS:\n{{ $('Normalize Meeting Output').first().json.actionItemsText }}\n\nRISKS:\n{{ $('Normalize Meeting Output').first().json.risks }}",
        "options": {}
      },
      "typeVersion": 2.1
    },
    {
      "id": "preflight",
      "name": "Preflight",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "jsCode": "const env = $env;\nconst enabled = env.ACTIONFLOW_ENABLED === 'true';\nconst dryRun = env.ACTIONFLOW_DRY_RUN !== 'false';\nconst required = [\"MEETING_SHEET_ID\", \"MEETING_EMAIL_TO\", \"ACTIONFLOW_ALERT_EMAIL_TO\"];\nif (enabled && !dryRun) {\n  const missing = required.filter(key => !String(env[key] || '').trim());\n  if (missing.length) throw new Error('Missing configuration: ' + missing.join(', '));\n}\nconst runId = String($execution.id);\nconst status = !enabled ? 'disabled' : dryRun ? 'dry_run' : 'running';\nconsole.log(JSON.stringify({timestamp: new Date().toISOString(), runId, workflow: 'ACTIONFLOW', status}));\nconst first = $input.first();\nreturn [{json: {...first.json, runId, status, runLive: status === 'running'}, ...(first.binary ? {binary: first.binary} : {})}];"
      }
    },
